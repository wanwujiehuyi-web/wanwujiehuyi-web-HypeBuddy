# ============================================================
# HypeBuddy 配置模板
# ============================================================
# 用法：把本文件复制成 .env，然后填入你自己的 Key。
#       .env 已被 .gitignore 排除，不会进仓库；本文件可以公开。
# ============================================================

# ---------- 大模型（必填）----------
# 兼容 OpenAI 接口的任何服务都行：DeepSeek / 通义 / 智谱 / ModelScope …
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat


# ---------- 语音（可选，默认关）----------
# false = 纯文字运行（推荐，也是默认值）
# true  = 开声音，需要额外安装 edge-tts：
#         pip install edge-tts
VOICE_ENABLED=false

# 语音引擎（只有 VOICE_ENABLED=true 时才看这一行）
#   edge = 微软 edge-tts，免费、免注册
TTS_ENGINE=edge

# 备注：voice.py 里还留了一条火山引擎的接入代码（方言音色），
#      但因为商用 TTS 做不出地道方言，这条路已经放弃，详见 README。
#      想了解细节可以去翻 voice.py，不需要在这里配置任何东西。
